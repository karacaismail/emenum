{
  "project_root": "/Users/karaca/Desktop/ozon",
  "project_type": "single",
  "services": {
    "main": {
      "name": "ozon-nextjs-app",
      "path": ".",
      "language": "TypeScript",
      "framework": "Next.js 15.5.9 (App Router)",
      "react_version": "19.0.0",
      "type": "fullstack",
      "package_manager": "npm",
      "default_port": 3000,
      "styling": "Tailwind CSS 4.1.18",
      "database": "Supabase (PostgreSQL)",
      "auth": "Supabase Auth with SSR",
      "dev_command": "npm run dev",
      "test_command": "npm run test",
      "typecheck_command": "npm run typecheck",
      "lint_command": "npm run lint",
      "key_directories": {
        "app": {
          "path": "app",
          "purpose": "Next.js App Router pages and layouts"
        },
        "app/(auth)": {
          "path": "app/(auth)",
          "purpose": "Authentication pages (login, register)"
        },
        "app/(admin)": {
          "path": "app/(admin)",
          "purpose": "Admin panel pages (super admin only)"
        },
        "app/(dashboard)": {
          "path": "app/(dashboard)",
          "purpose": "User dashboard pages"
        },
        "components": {
          "path": "components",
          "purpose": "Reusable UI components"
        },
        "lib": {
          "path": "lib",
          "purpose": "Library code, services, utilities"
        },
        "lib/supabase": {
          "path": "lib/supabase",
          "purpose": "Supabase client configuration"
        },
        "hooks": {
          "path": "hooks",
          "purpose": "Custom React hooks"
        },
        "tests": {
          "path": "tests",
          "purpose": "Test files (Vitest)"
        }
      },
      "key_files": {
        "middleware": "middleware.ts",
        "layout": "app/layout.tsx",
        "admin_layout": "app/(admin)/layout.tsx",
        "dashboard_layout": "app/(dashboard)/layout.tsx",
        "auth_layout": "app/(auth)/layout.tsx"
      }
    }
  },
  "infrastructure": {
    "docker": false,
    "database": "Supabase PostgreSQL (hosted)",
    "ci_cd": false
  },
  "conventions": {
    "linter": "eslint",
    "formatter": "prettier (implicit)",
    "testing": "vitest",
    "language": "Turkish for UI, English for code",
    "component_style": "Server Components by default, 'use client' for interactive parts",
    "form_pattern": "Server page -> Client form component",
    "admin_pattern": "Server data fetch -> Client interactive component"
  },
  "environment_variables": {
    "required": [
      "NEXT_PUBLIC_SUPABASE_URL",
      "NEXT_PUBLIC_SUPABASE_ANON_KEY"
    ],
    "optional": [
      "NEXT_PUBLIC_APP_URL",
      "NEXT_PUBLIC_APP_DOMAIN"
    ],
    "production_values": {
      "NEXT_PUBLIC_APP_URL": "https://e-menum.net",
      "NEXT_PUBLIC_APP_DOMAIN": "e-menum.net"
    }
  }
}
