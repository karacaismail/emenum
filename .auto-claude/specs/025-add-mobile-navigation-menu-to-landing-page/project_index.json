{
  "project_type": "single",
  "services": {
    "frontend": {
      "path": ".",
      "tech_stack": ["next.js@15", "react@19", "typescript@5.7", "tailwindcss@3.4"],
      "port": 3000,
      "dev_command": "npm run dev",
      "test_command": "npm run test",
      "build_command": "npm run build"
    }
  },
  "infrastructure": {
    "docker": false,
    "database": "supabase",
    "ci_cd": false
  },
  "conventions": {
    "linter": "eslint",
    "formatter": "prettier (via next)",
    "testing": "vitest",
    "component_pattern": "functional components with hooks",
    "styling": "tailwind utility classes",
    "client_components": "use 'use client' directive when state is needed"
  }
}
