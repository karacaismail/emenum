{
  "project_type": "single",
  "services": {
    "frontend": {
      "path": ".",
      "tech_stack": ["nextjs", "react", "typescript", "tailwindcss"],
      "framework_version": "Next.js 15.5",
      "port": 3000,
      "dev_command": "npm run dev",
      "build_command": "npm run build",
      "test_command": "npm run test",
      "test_framework": "vitest"
    }
  },
  "infrastructure": {
    "docker": false,
    "database": "supabase-postgresql",
    "hosting": "vercel"
  },
  "conventions": {
    "linter": "eslint",
    "formatter": "prettier",
    "testing": "vitest",
    "component_pattern": "functional components with TypeScript",
    "styling": "tailwindcss with utility classes",
    "file_structure": "app router with route groups"
  }
}
