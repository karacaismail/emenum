{
  "project_type": "single",
  "services": {
    "frontend": {
      "path": ".",
      "tech_stack": ["nextjs", "typescript", "react", "tailwindcss"],
      "port": 3000,
      "dev_command": "npm run dev",
      "test_command": "npm run test",
      "build_command": "npm run build"
    }
  },
  "infrastructure": {
    "docker": false,
    "database": "supabase_postgresql",
    "auth": "supabase_auth"
  },
  "conventions": {
    "linter": "eslint",
    "formatter": "prettier",
    "testing": "vitest",
    "styling": "tailwindcss",
    "language": "turkish"
  },
  "key_directories": {
    "app": "Next.js App Router pages and layouts",
    "components": "Reusable React components",
    "lib": "Utility functions and configurations",
    "hooks": "Custom React hooks"
  }
}
